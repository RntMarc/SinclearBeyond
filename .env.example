# General
NEXT_PUBLIC_ORIGIN="domain.de"
NODE_ENV="production"

# Auth
ALLOWED_EMAIL_DOMAINS="domain1.de,domain2.de"
JWT_SECRET="secretsecretsecretsecretsecret"

# Database
DB_HOST="db.domain.de"
DB_NAME="db_123456_78"
DB_PASSWORD="your_secure_password"
DB_PORT="3306"
DB_USER="db_user"

# E-Mail
SMTP_FROM="Sinclear Beyond <beyond@domain.de>"
SMTP_HOST="mail.domain.de"
SMTP_PASS="your_secure_password"
SMTP_PORT="587"
SMTP_SECUE="true"
SMTP_USER="beyond@domain.de"

# Discord
DISCORD_CLIENT_ID="123456789123456789"
DISCORD_CLIENT_SECRET="secretsecretsecretsecretsecret"
DISCORD_REDIRECT_URI="https://domain.de/api/auth/discord/callback"
DISCORD_ALLOWED_GUILD_ID="12356789123"

# Twitch
TWITCH_CLIENT_ID="abcd123456789abcd123456"
TWITCH_CLIENT_SECRET="secretsecretsecret"

# TMDB
TMDB_API_KEY="keykeykeykeykey"

# Unsplash
UNSPLASH_API_KEY="keykeykeykeykey"

# Web Push (VAPID) – für PWA Push-Benachrichtigungen
# Generiere mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="publickeypublickeypublickey"
VAPID_PRIVATE_KEY="privatekeyprivatekeyprivatekey"
VAPID_SUBJECT="mailto:beyond@domain.de"

# PWA
NEXT_PUBLIC_VAPID_PUBLIC_KEY="publickeypublickeypublickey"
